# MCP server connection. The client appends /mcp when needed.
MCP_SERVER_URL=http://127.0.0.1:8080
MCP_ACCESS_TOKEN=replace-with-the-same-token-used-by-mcp-server

# Azure OpenAI Responses API.
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://tiff-sweden.openai.azure.com/openai/v1/responses?api-version=preview
AZURE_OPENAI_DEPLOYMENT=replace-with-your-deployment-name

# Telegram bot and webhook verification.
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Optional. When set, POST /chat requires "Authorization: Bearer <token>".
# Recommended whenever ngrok is running, because ngrok makes /chat public too.
CHAT_ACCESS_TOKEN=

# Optional local server settings.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
