# Required for POST /mcp and GET /logs endpoints.
MCP_ACCESS_TOKEN=replace-with-a-long-random-token

# Optional server settings.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
LOG_FILE_PATH=./mcp_server.log
CORS_ORIGINS=

# Optional backend settings for _make_backend_request.
BACKEND_BASE_URL=
BACKEND_TIMEOUT=30
SERVER_NAME=mcp-template-via-tiff
SERVER_VERSION=1.0.0

# Do not store the downstream API key here. The trusted MCP caller supplies it
# per request in the x-backend-api-key header.
