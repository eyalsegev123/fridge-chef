# Required for POST /mcp and GET /logs endpoints.
MCP_ACCESS_TOKEN=replace-with-a-long-random-token

# Optional server settings.
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
LOG_FILE_PATH=./mcp_server.log
CORS_ORIGINS=

# Optional overrides. Leave blank to use config.json (TheMealDB, 30s timeout).
BACKEND_BASE_URL=
BACKEND_TIMEOUT=
SERVER_NAME=
SERVER_VERSION=

# TheMealDB's public test key is part of the URL in config.json, so no
# downstream API key is needed.
